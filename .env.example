# Where jav_config.ws lives — the same file the desktop launcher reads.
#
# `codebase` in it names the host to play against, and the client reads it on every boot, so moving
# a world is one edit on the server rather than a rebuild here. The port is always 8091.
#
# Empty uses the published config: https://central.fluxious-rsps.com/jav_config.ws
#
# Locally, run the central server and use the dev proxy: VITE_JAV_CONFIG_URL=/central/jav_config.ws
VITE_JAV_CONFIG_URL=

# Where the world list lives. Empty takes worldslist.ws from the same server as the config, which
# is where central publishes it; set only if the two are served separately.
VITE_WORLD_LIST_URL=

# Empty follows the page's own scheme: an HTTPS site uses wss, an HTTP one uses ws. Set to false
# only if the bridge is plain HTTP behind an HTTPS site, and expect the browser to block it.
VITE_GAME_WS_SECURE=

# The port the bridge is reachable on. Empty uses 8091, the bridge's own port. Behind TLS set it to
# whatever terminates: 443 for a Cloudflare tunnel, 8443 for a reverse proxy on a proxied port.
# Cloudflare's proxy only accepts 443, 2053, 2083, 2087, 2096 and 8443 for HTTPS, so 8091 cannot be
# proxied.
VITE_BRIDGE_PORT=
