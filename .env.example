# Where jav_config.ws lives — the same file the desktop launcher reads.
#
# `codebase` in it names the host to play against, and the client reads it on every boot, so moving
# a world is one edit on the server rather than a rebuild here. The port is always 8091.
#
# Empty uses the published config: https://central.fluxious-rsps.com/jav_config.ws
VITE_JAV_CONFIG_URL=

# Empty follows the page's own scheme: an HTTPS site uses wss, an HTTP one uses ws. Set to false
# only if the bridge is plain HTTP behind an HTTPS site, and expect the browser to block it.
VITE_GAME_WS_SECURE=
